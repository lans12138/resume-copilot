# Application and logging
APP_ENV=local
APP_NAME=resume-copilot
LOG_LEVEL=INFO
LOG_FORMAT=json
PUBLIC_BASE_URL=http://localhost:8080
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:5173
REQUEST_ID_HEADER=X-Request-ID
API_HOST_PORT=8000

# Authentication — replace placeholders only in an ignored .env file
JWT_SECRET=replace-with-at-least-48-random-characters-xxxxxxxxxxxx
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
PASSWORD_HASH_SCHEME=argon2
LOGIN_RATE_LIMIT=10/minute

# PostgreSQL
POSTGRES_DB=resume_copilot
POSTGRES_USER=resume_app
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql+asyncpg://resume_app:replace-with-local-database-password@postgres:5432/resume_copilot
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30
DB_ECHO=false
POSTGRES_HOST_PORT=5433

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=300
SCHEDULER_TIMEZONE=UTC
REDIS_HOST_PORT=6380

# Files and parsing
STORAGE_BACKEND=local-volume
STORAGE_ROOT=/data/resumes
MAX_FILE_SIZE_MB=10
MAX_BATCH_FILES=20
MAX_PDF_PAGES=50
MAX_EXTRACTED_CHARS=200000
PARSER_TIMEOUT_SECONDS=60
PARSER_VERSION=v1

# Model and embeddings; FakeModel remains the local default
MODEL_BASE_URL=https://replace-with-provider-endpoint.invalid/v1
QWEN_API_KEY=replace-with-local-api-key
CHAT_MODEL=qwen3.7-plus
MODEL_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
MOCK_MODEL_MODE=true

# Retrieval, runs, approvals, and SSE
TOP_K=10
RRF_K=60
STRUCTURED_WEIGHT=1.0
KEYWORD_WEIGHT=1.0
VECTOR_WEIGHT=1.0
HNSW_ENABLED=false
NODE_TIMEOUT_SECONDS=120
MAX_TRANSIENT_RETRIES=2
APPROVAL_TTL_MINUTES=60
SSE_HEARTBEAT_SECONDS=15
SSE_BATCH_SIZE=100
SSE_RETRY_MILLISECONDS=1000

# Observability and version snapshots
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://replace-with-langfuse-host.invalid
LANGFUSE_PUBLIC_KEY=replace-with-local-public-key
LANGFUSE_SECRET=replace-with-local-secret
PROMPT_VERSION=v1
RULE_VERSION=v1
