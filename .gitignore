# Local environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/

# Node and frontend output
node_modules/
apps/web/dist/
apps/web/coverage/
apps/web/playwright-report/
apps/web/test-results/
*.tsbuildinfo

# IDE and operating system
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime output
logs/
tmp/
*.log

# Local probe scratch. The CI workflows keep their logs as workflow artefacts,
# so these are only ever local debugging leftovers and must never be committed.
ci_logs/
git_verify.txt
/probe_tmp/

# Ad-hoc root-level diagnostics. Canonical probes belong in tests/; files with
# these names are disposable command output and one-off troubleshooting helpers.
/_*.log
/_*.out
/_*.txt
/_*.ps1
/_*.py
/_*.json
/_*.exit
